# CIPHERON-X1 Tactical Appliance - Environment Configuration

# Optional remote backend URL when deployed on Vercel
# Leave blank when proxying through localhost or same-origin
# Example: https://cipheron-backend.onrender.com or https://cipheron-api.railway.app
VITE_API_BASE_URL=

# Optional dedicated WebSocket streaming URL
# Example: wss://cipheron-backend.onrender.com/ws/stream
VITE_WS_URL=
